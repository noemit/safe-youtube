{
  // The name shown in the browser, on the home screen, and in the app.
  "siteTitle": "Safe YouTube",

  // A short sentence that explains what this app is for.
  "siteDescription": "A parent-friendly YouTube wrapper with common-sense controls for kids.",

  // This text appears near the main search box.
  "welcomeMessage": "Set safer search rules, approve good channels, and make video hopping less rewarding.",

  // These big buttons appear on the home screen.
  // Keep the labels short so young readers can understand them easily.
  // Emojis are fine here and can make the topics easier to spot.
  "categories": [
    {
      "label": "🐘 Animals",
      "query": "animal facts for kids"
    },
    {
      "label": "🚀 Space",
      "query": "space documentary for kids"
    },
    {
      "label": "🎨 Drawing",
      "query": "drawing tutorial for beginners"
    },
    {
      "label": "🧱 Lego",
      "query": "lego building ideas"
    }
  ],

  // Choose one:
  // "blocklist" = hide anything that matches your blocked words, channels, or videos.
  // "allowlist" = only show approved topics, approved channels, or approved videos.
  "mode": "blocklist",

  // Optional: paste full YouTube video links here.
  // These videos will be featured on the home page.
  "featuredVideos": [],

  // Optional: paste channel handles, channel names, or full channel URLs here.
  // Example values:
  // "@SciShowKids"
  // "National Geographic Kids"
  // "https://www.youtube.com/@ArtforKidsHub"
  "featuredChannels": [
    "@SLICKSLIMESAMDIYComedyScience",
    "@Blippi",
    "@Numberblocks",
    "@NumberjacksTV",
    "@desene-animate-romana-tralala"
  ],

  // Optional: these approved videos can appear below the player and be used
  // as "next up" suggestions after a video ends.
  // If this list is empty, the app falls back to featuredVideos and allowedVideos.
  "watchSuggestions": [],

  // BLOCKLIST MODE
  // Hide results if the title, description, or channel contains any of these words.
  "blockedWords": ["horror", "gore", "violence", "prank"],

  // Hide results from these channels.
  "blockedChannels": [],

  // Hide specific videos by pasting full YouTube links or 11-character video IDs.
  "blockedVideos": [],

  // ALLOWLIST MODE
  // Optional: only allow searches that contain one of these terms.
  // Leave this empty if you only want to approve by channel or video.
  "allowedSearchTerms": [],

  // Only show videos from these channels.
  "allowedChannels": [
    "@desene-animate-romana-tralala"
  ],

  // Only show these exact videos.
  "allowedVideos": [],

  // WATCH EXPERIENCE
  "watchExperience": {
    // If a child taps a different video through YouTube's own "More videos" UI,
    // stop the player and show the Safe YouTube overlay again.
    "blockUnexpectedVideoChanges": true,

    // Show the approved suggestions below the main player after this many seconds.
    "revealSuggestionsAfterSeconds": 5,

    // After a video ends, start the first approved suggestion automatically.
    "autoPlayNextSuggestion": true,

    // How long the end-of-video countdown should last.
    "autoPlayNextSuggestionSeconds": 10
  },

  // RAPID VIDEO SWITCHING CONTROL
  // Turn this on if you want to make fast video-hopping less rewarding.
  // After too many switches in a short time, the next video is paused.
  "videoSwitchingControl": {
    // false = off
    "enabled": false,

    // "cooldown" = wait, then the video opens automatically.
    // "confirm" = wait, then the child must tap Continue.
    "mode": "cooldown",

    // If a child opens more than this many different videos inside the time window,
    // the pause starts on the next one.
    "maxSwitchesInWindow": 4,

    // How far back the app looks when counting switches.
    "windowSeconds": 180,

    // How long the pause should last.
    "cooldownSeconds": 15,

    // Text shown during the pause screen.
    "title": "Pause before the next video",
    "message": "Fast switching can make YouTube harder to stop. Take a short pause before opening another video.",
    "buttonText": "Continue to the video"
  },

  // Simple colors for the app shell.
  "theme": {
    "accentColor": "#d76546",
    "accentTint": "#f3d2c7"
  }
}
