{
  "siteTitle": "Kids Safe YouTube",
  "siteDescription": "A calmer YouTube setup for everyday family use.",
  "welcomeMessage": "Search normally, but keep out the channels and keywords you do not want in the house.",
  // Use `1` for yes and `0` for no.
  "simpleSettings": {
    "allowSearching": 1,
    "allowOnlyApprovedChannels": 0,
    "allowOnlyApprovedVideos": 0,
    "slowDownFastSwitching": 0
  },
  "mode": "blocklist",
  // `label` = the button a child sees.
  // `searchFor` = the words Safe YouTube searches for when that button is tapped.
  "categories": [
    { "label": "🐘 Animals", "searchFor": "animal facts for kids" },
    { "label": "✂️ Crafts", "searchFor": "easy crafts for kids" },
    { "label": "🧱 Lego", "searchFor": "lego building ideas" },
    { "label": "🧪 Science", "searchFor": "science experiments for kids" }
  ],
  "featuredVideos": [],
  "featuredChannels": [
    "SciShow Kids",
    "Art for Kids Hub",
    "National Geographic Kids"
  ],
  "blockedWords": [
    "horror",
    "gore",
    "violence",
    "prank",
    "creepypasta",
    "jump scare"
  ],
  "blockedChannels": [],
  "blockedVideos": [],
  "allowedSearchTerms": [],
  "allowedChannels": [],
  "allowedVideos": [],
  "videoSwitchingControl": {
    "enabled": false,
    "mode": "cooldown",
    "maxSwitchesInWindow": 4,
    "windowSeconds": 180,
    "cooldownSeconds": 15,
    "title": "Pause before the next video",
    "message": "Fast switching can make YouTube harder to stop. Take a short pause before opening another video.",
    "buttonText": "Continue to the video"
  },
  "theme": {
    "accentColor": "#d76546",
    "accentTint": "#f3d2c7"
  }
}
