{
  "siteTitle": "Approved Channels Only",
  "siteDescription": "A stricter Safe YouTube setup for younger kids.",
  "welcomeMessage": "This version only shows videos from trusted channels picked by a parent.",
  // Use `1` for yes and `0` for no.
  "simpleSettings": {
    "allowSearching": 1,
    "allowOnlyApprovedChannels": 1,
    "allowOnlyApprovedVideos": 0,
    "slowDownFastSwitching": 1
  },
  "mode": "allowlist",
  // `label` = the button a child sees.
  // `searchFor` = the words Safe YouTube searches for when that button is tapped.
  "categories": [
    { "label": "🧪 Science", "searchFor": "science for kids" },
    { "label": "🎨 Drawing", "searchFor": "drawing for kids" },
    { "label": "🔤 Phonics", "searchFor": "phonics songs" },
    { "label": "🌿 Nature", "searchFor": "nature for kids" }
  ],
  "featuredVideos": [],
  "featuredChannels": [
    "SciShow Kids",
    "Art for Kids Hub",
    "National Geographic Kids"
  ],
  "blockedWords": ["horror", "gore", "violence", "prank"],
  "blockedChannels": [],
  "blockedVideos": [],
  "allowedSearchTerms": [],
  "allowedChannels": [
    "SciShow Kids",
    "Art for Kids Hub",
    "National Geographic Kids"
  ],
  "allowedVideos": [],
  "videoSwitchingControl": {
    "enabled": true,
    "mode": "cooldown",
    "maxSwitchesInWindow": 3,
    "windowSeconds": 180,
    "cooldownSeconds": 20,
    "title": "Slow down for a moment",
    "message": "This app is set up to slow down fast channel surfing. Wait a moment before the next video opens.",
    "buttonText": "Continue to the video"
  },
  "theme": {
    "accentColor": "#4474a6",
    "accentTint": "#d7e5f4"
  }
}
