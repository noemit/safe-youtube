{
  "siteTitle": "Approved Channels Only",
  "siteDescription": "A stricter Safe YouTube setup for younger kids.",
  "welcomeMessage": "This version only shows videos from trusted channels picked by a parent.",
  "mode": "allowlist",
  "categories": [
    { "label": "Science", "query": "science for kids" },
    { "label": "Drawing", "query": "drawing for kids" },
    { "label": "Phonics", "query": "phonics songs" },
