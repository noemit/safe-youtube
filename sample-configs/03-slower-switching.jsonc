{
  "siteTitle": "Calm YouTube Time",
  "siteDescription": "A parent setup that allows browsing, but slows down rapid skipping.",
  "welcomeMessage": "Use parent-approved search rules, and make endless video hopping less rewarding.",
  // Use `1` for yes and `0` for no.
  "simpleSettings": {
    "allowSearching": 1,
    "allowOnlyApprovedChannels": 0,
    "allowOnlyApprovedVideos": 0,
    "slowDownFastSwitching": 1
  },
  "mode": "blocklist",
  // `label` = the button a child sees.
  // `searchFor` = the words Safe YouTube searches for when that button is tapped.
  "categories": [
    { "label": "📚 Stories", "searchFor": "bedtime stories for kids" },
    { "label": "🎵 Music", "searchFor": "sleep music for kids" },
    { "label": "🌬️ Breathing", "searchFor": "guided breathing for children" },
    { "label": "🎨 Drawing", "searchFor": "calm drawing tutorial" }
  ],
  "featuredVideos": [],
  "featuredChannels": [
    "Cosmic Kids Yoga",
    "Art for Kids Hub"
  ],
  "blockedWords": [
    "horror",
    "gore",
    "violence",
    "prank",
    "creepy",
    "scary"
  ],
  "blockedChannels": [],
  "blockedVideos": [],
  "allowedSearchTerms": [],
  "allowedChannels": [],
  "allowedVideos": [],
  "videoSwitchingControl": {
    "enabled": true,
    "mode": "confirm",
    "maxSwitchesInWindow": 2,
    "windowSeconds": 180,
    "cooldownSeconds": 25,
    "title": "Take a breath before the next video",
    "message": "This parent setting adds a calm pause when videos are switched too quickly.",
    "buttonText": "Open the next video"
  },
  "theme": {
    "accentColor": "#4d8771",
    "accentTint": "#d6ebe4"
  }
}
